APP_NAME="Smart Document Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Cơ sở dữ liệu (XAMPP: user root, mật khẩu rỗng) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smart_document_hub
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# Xử lý tệp chạy ở hàng đợi database: nhớ chạy "php artisan queue:work" (hoặc file chay-queue.bat)
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# --- Mail: mặc định ghi ra storage/logs/laravel.log (link đặt lại mật khẩu nằm trong log) ---
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@smartdocumenthub.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Gemini API (CHỈ đặt ở đây, không bao giờ đưa lên Git/giao diện) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=40
GEMINI_RETRIES=2

# --- Tải lên (KB). Cần <= upload_max_filesize / post_max_size trong php.ini ---
UPLOAD_MAX_KB=20480
